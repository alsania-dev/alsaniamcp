modules = ["nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AlsaniaMCP Server"

[[workflows.workflow]]
name = "AlsaniaMCP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5050

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5050
externalPort = 80

[[ports]]
localPort = 33103
externalPort = 3000
